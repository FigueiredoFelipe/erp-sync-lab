# Copy to .env and fill in. Never commit .env.

# Supabase project
SUPABASE_URL=
# Publishable (anon) key: public by design, data is protected by RLS. The only key the dashboard gets.
SUPABASE_PUBLISHABLE_KEY=
# Service-role key: bypasses RLS. Local scripts and Edge Function secrets only, never Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, used by `supabase db push --db-url` and the SQL tests
DATABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Shared secret pg_cron sends to the Edge Functions (x-cron-secret); also stored in Vault and in the Supabase secrets
CRON_SECRET=

# ERPNext (Source A), read-only API access
ERPNEXT_URL=https://your-site.example.com
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# HMAC secret for the ERPNext Webhook; same value in the Supabase secrets and in ERPNext
ERPNEXT_WEBHOOK_SECRET=

# Comma-separated Google account emails allowed to read the dashboard (scripts/ops/set-allowlist.ts)
ALLOWLIST_EMAILS=

# true = public demo mode: every page redirects to /demo and /api/* and /auth/* return 404.
# false = full dashboard with Google sign-in and the data API.
DEMO_ONLY=false
