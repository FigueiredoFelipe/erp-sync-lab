<mxfile host="drawio" type="device"><diagram id="flow" name="Flow"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;erp-sync-lab — architecture (PLAN.md, updated 2026-10-19)&lt;/b&gt;&lt;br&gt;Every source converges on one queue; only invoice-consumer (via internal.apply_record) writes the read models. Schedules and attempts follow the decided Q3 (poll every 5 min), Q4 (5 attempts) and Q6 (daily reconciliation). The dashboard reads with the user&#x27;s session; Postgres RLS is the gate." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1700" height="46" as="geometry"/></mxCell><mxCell id="lane_src" value="Sources" style="swimlane;startSize=30;fontStyle=1;fontSize=14;rounded=1;arcSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f3f7fd;html=1;whiteSpace=wrap;container=1;collapsible=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="250" height="1280" as="geometry"/></mxCell><mxCell id="erpnext" value='&lt;b&gt;ERPNext v16 (cloud)&lt;/b&gt;&lt;br&gt;REST API, company&lt;br&gt;Harvest Table Foods&lt;br&gt;&lt;font face="Courier New"&gt;Sales Invoice&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;Deleted Document&lt;/font&gt;&lt;br&gt;&lt;br&gt;read-only API user&lt;br&gt;(GET only, BR09)&lt;br&gt;modified: NY local, no TZ' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="210" height="280" as="geometry"/></mxCell><mxCell id="legacy_export" value='&lt;b&gt;Legacy Unit B&lt;/b&gt;&lt;br&gt;on-premise CSV export&lt;br&gt;&lt;font face="Courier New"&gt;unit_b_export_&amp;lt;YYYYMMDD&amp;gt;.csv&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="210" height="90" as="geometry"/></mxCell><mxCell id="operator" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;uploads the export file&lt;br&gt;(insert-only, never replaced)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="210" height="80" as="geometry"/></mxCell><mxCell id="lane_supa" value="Supabase (free plan)" style="swimlane;startSize=30;fontStyle=1;fontSize=14;rounded=1;arcSize=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f4faf3;html=1;whiteSpace=wrap;container=1;collapsible=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="1560" height="1280" as="geometry"/></mxCell><mxCell id="cron" value='&lt;b&gt;pg_cron → pg_net&lt;/b&gt; (async HTTP) with &lt;font face="Courier New"&gt;x-cron-secret&lt;/font&gt; header from Vault (constant-time check) — every schedule is a &lt;font face="Courier New"&gt;cron.schedule()&lt;/font&gt; in a migration&lt;br&gt;daily cleanup = SQL-only job (not an Edge Function): trims &lt;font face="Courier New"&gt;cron.job_run_details&lt;/font&gt; / &lt;font face="Courier New"&gt;net._http_response&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#b9e0a5;" vertex="1" parent="1"><mxGeometry x="330" y="95" width="1500" height="66" as="geometry"/></mxCell><mxCell id="lane_fn" value="Edge Functions (Deno) — thin handlers → services; ≤150 s wall clock, I/O only" style="swimlane;startSize=26;fontStyle=1;fontSize=12;rounded=1;arcSize=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f4faf3;html=1;whiteSpace=wrap;container=1;collapsible=0;strokeWidth=1.5;" vertex="1" parent="lane_supa"><mxGeometry x="30" y="130" width="1500" height="180" as="geometry"/></mxCell><mxCell id="fn_poll" value="&lt;b&gt;erpnext-poll&lt;/b&gt;&lt;br&gt;&lt;b&gt;IncrementalSync&lt;/b&gt; (handwritten)&lt;br&gt;invoices + Deleted Document&lt;br&gt;stops at 100 s · sync_run.fetched" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="lane_fn"><mxGeometry x="70" y="40" width="250" height="120" as="geometry"/></mxCell><mxCell id="fn_webhook" value='&lt;b&gt;erpnext-webhook&lt;/b&gt; &lt;span style="background:#ffe599;border:1px solid #bf9000;border-radius:3px;padding:0 3px;font-weight:bold;"&gt;P2&lt;/span&gt;&lt;br&gt;&lt;font face="Courier New"&gt;verify_jwt = false&lt;/font&gt;&lt;br&gt;HMAC-SHA256 over raw body&lt;br&gt;bad/missing → 401 Problem Details' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;dashed=1;dashPattern=8 4;strokeWidth=2;" vertex="1" parent="lane_fn"><mxGeometry x="360" y="40" width="250" height="120" as="geometry"/></mxCell><mxCell id="fn_legacy" value="&lt;b&gt;legacy-ingest&lt;/b&gt;&lt;br&gt;one file per run, oldest export first&lt;br&gt;older than newest ingested → rejected (BR10)&lt;br&gt;same content as newest → export date only&lt;br&gt;≤5,000 rows · strict CSV, group by INV_NO&lt;br&gt;records + tombstones for missing invoices" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="lane_fn"><mxGeometry x="650" y="40" width="250" height="120" as="geometry"/></mxCell><mxCell id="fn_consumer" value="&lt;b&gt;invoice-consumer&lt;/b&gt;&lt;br&gt;≤10 msgs/run, try/catch per msg&lt;br&gt;begin_attempt → validate&lt;br&gt;→ apply_record · heartbeat" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="lane_fn"><mxGeometry x="940" y="40" width="250" height="120" as="geometry"/></mxCell><mxCell id="fn_reconcile" value='&lt;b&gt;reconcile-erpnext&lt;/b&gt;&lt;br&gt;per-document diff&lt;br&gt;on demand:&lt;br&gt;&lt;font face="Courier New"&gt;select internal.trigger_reconcile()&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="lane_fn"><mxGeometry x="1230" y="40" width="250" height="120" as="geometry"/></mxCell><mxCell id="lane_storage" value="Storage" style="swimlane;startSize=26;fontStyle=1;fontSize=12;rounded=1;arcSize=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f4faf3;html=1;whiteSpace=wrap;container=1;collapsible=0;strokeWidth=1.5;" vertex="1" parent="lane_supa"><mxGeometry x="30" y="480" width="830" height="120" as="geometry"/></mxCell><mxCell id="st_raw" value='&lt;b&gt;bucket raw&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;erpnext/&amp;lt;name&amp;gt;/&lt;br&gt;&amp;lt;docstatus&amp;gt;-&amp;lt;modified&amp;gt;.json&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;fontSize=11;" vertex="1" parent="lane_storage"><mxGeometry x="20" y="35" width="175" height="70" as="geometry"/></mxCell><mxCell id="st_legacy" value="&lt;b&gt;bucket legacy-uploads&lt;/b&gt;&lt;br&gt;insert-only (no update,&lt;br&gt;upsert: false)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="lane_storage"><mxGeometry x="550" y="35" width="220" height="70" as="geometry"/></mxCell><mxCell id="lane_queue" value="Supabase Queues (pgmq) — durable/logged, not exposed via PostgREST (service role only)" style="swimlane;startSize=26;fontStyle=1;fontSize=12;rounded=1;arcSize=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f4faf3;html=1;whiteSpace=wrap;container=1;collapsible=0;strokeWidth=1.5;" vertex="1" parent="lane_supa"><mxGeometry x="30" y="680" width="1500" height="140" as="geometry"/></mxCell><mxCell id="q_main" value='&lt;b&gt;invoice_events&lt;/b&gt;&lt;br&gt;kinds: record · hint &lt;span style="background:#ffe599;border:1px solid #bf9000;border-radius:3px;padding:0 3px;font-weight:bold;"&gt;P2&lt;/span&gt; · tombstone · revalidate&lt;br&gt;visibility timeout 180 s &amp;gt; 150 s limit' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#b9e0a5;" vertex="1" parent="lane_queue"><mxGeometry x="230" y="38" width="360" height="90" as="geometry"/></mxCell><mxCell id="q_dlq" value="&lt;b&gt;invoice_events_dlq&lt;/b&gt;&lt;br&gt;manual DLQ on attempts&lt;br&gt;count shown on dashboard" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane_queue"><mxGeometry x="1150" y="40" width="240" height="85" as="geometry"/></mxCell><mxCell id="lane_pg" value="Postgres — two schemas" style="swimlane;startSize=26;fontStyle=1;fontSize=12;rounded=1;arcSize=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;swimlaneFillColor=#eaf5e9;html=1;whiteSpace=wrap;container=1;collapsible=0;strokeWidth=1.5;" vertex="1" parent="lane_supa"><mxGeometry x="30" y="860" width="1500" height="400" as="geometry"/></mxCell><mxCell id="g_internal" value="internal — not exposed via API; EXECUTE revoked from PUBLIC/anon/authenticated (service_role only), except is_allowlisted() for authenticated (RLS policies call it)" style="swimlane;startSize=24;fontStyle=1;fontSize=11;rounded=1;arcSize=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;swimlaneFillColor=#eaf5e9;html=1;whiteSpace=wrap;container=1;collapsible=0;strokeWidth=1.5;" vertex="1" parent="lane_pg"><mxGeometry x="20" y="40" width="730" height="345" as="geometry"/></mxCell><mxCell id="g_public" value="public — read models behind RLS (SELECT only, allowlisted users)" style="swimlane;startSize=24;fontStyle=1;fontSize=11;rounded=1;arcSize=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;swimlaneFillColor=#eaf5e9;html=1;whiteSpace=wrap;container=1;collapsible=0;strokeWidth=1.5;" vertex="1" parent="lane_pg"><mxGeometry x="770" y="40" width="710" height="345" as="geometry"/></mxCell><mxCell id="t_version" value='&lt;b&gt;&lt;font face="Courier New"&gt;record_version&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;applied_version (atomic guard)&lt;br&gt;enqueued_version&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="g_internal"><mxGeometry x="15" y="36" width="225" height="62" as="geometry"/></mxCell><mxCell id="t_alias" value='&lt;b&gt;&lt;font face="Courier New"&gt;customer_alias&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;(source, match_key) → canonical_id&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="g_internal"><mxGeometry x="250" y="36" width="225" height="62" as="geometry"/></mxCell><mxCell id="t_mapstate" value='&lt;b&gt;&lt;font face="Courier New"&gt;mapping_state&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;current mapping_version&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="g_internal"><mxGeometry x="485" y="36" width="225" height="62" as="geometry"/></mxCell><mxCell id="t_cursor" value='&lt;b&gt;&lt;font face="Courier New"&gt;sync_cursor&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;(source, stream): invoices&lt;br&gt;(modified, name) · deleted (creation, name)&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="g_internal"><mxGeometry x="15" y="108" width="225" height="62" as="geometry"/></mxCell><mxCell id="t_attempt" value='&lt;b&gt;&lt;font face="Courier New"&gt;message_attempt&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;attempts actually started per msg&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="g_internal"><mxGeometry x="250" y="108" width="225" height="62" as="geometry"/></mxCell><mxCell id="t_allow" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;allowlist&lt;/font&gt;&lt;/b&gt; &lt;span style=&quot;background:#ffe599;border:1px solid #bf9000;border-radius:3px;padding:0 3px;font-weight:bold;&quot;&gt;P2&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Google identity email (auth.identities), owner only (Q5)&lt;br&gt;read by is_allowlisted() for RLS&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#ffffff;" vertex="1" parent="g_internal"><mxGeometry x="485" y="108" width="225" height="62" as="geometry"/></mxCell><mxCell id="t_switch" value='&lt;b&gt;&lt;font face="Courier New"&gt;test_switch&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;AC03 fault injection&lt;br&gt;(ENABLE_TEST_SWITCHES only)&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="g_internal"><mxGeometry x="15" y="180" width="225" height="110" as="geometry"/></mxCell><mxCell id="t_funcs" value="&lt;b&gt;write functions (EXECUTE: service_role only)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;enqueue_page · register_file · begin_attempt&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;apply_record · apply_customer_mapping&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;trigger_reconcile&lt;/font&gt;&lt;br&gt;&lt;b&gt;read wrappers in public (EXECUTE: authenticated)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;app_access · app_queue_metrics · app_test_switch&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;each answers only an allowlisted caller&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#e6f2e5;fontSize=11;" vertex="1" parent="g_internal"><mxGeometry x="250" y="180" width="460" height="155" as="geometry"/></mxCell><mxCell id="t_invoice" value='&lt;b&gt;&lt;font face="Courier New"&gt;invoice&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;valid only · signed amount&lt;br&gt;candidate, mapping_version&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="g_public"><mxGeometry x="15" y="36" width="220" height="62" as="geometry"/></mxCell><mxCell id="t_line" value='&lt;b&gt;&lt;font face="Courier New"&gt;invoice_line&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;(source, doc id, line_no)&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="g_public"><mxGeometry x="245" y="36" width="220" height="62" as="geometry"/></mxCell><mxCell id="t_recon" value='&lt;b&gt;&lt;font face="Courier New"&gt;reconciliation_result&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;(run_id, doc id) + class&lt;br&gt;+ per-month summary&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="g_public"><mxGeometry x="475" y="36" width="220" height="62" as="geometry"/></mxCell><mxCell id="t_quar" value='&lt;b&gt;&lt;font face="Courier New"&gt;quarantine&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;reason_codes[], candidate&lt;br&gt;open / resolved&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="g_public"><mxGeometry x="15" y="108" width="220" height="62" as="geometry"/></mxCell><mxCell id="t_customer" value='&lt;b&gt;&lt;font face="Courier New"&gt;customer&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;canonical_id&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="g_public"><mxGeometry x="245" y="108" width="220" height="62" as="geometry"/></mxCell><mxCell id="t_dead" value='&lt;b&gt;&lt;font face="Courier New"&gt;dead_letter&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;msg_id, attempts, last error&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="g_public"><mxGeometry x="475" y="108" width="220" height="62" as="geometry"/></mxCell><mxCell id="t_run" value='&lt;b&gt;&lt;font face="Courier New"&gt;sync_run&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;running/succeeded/incomplete/&lt;br&gt;failed · fetched (run log)&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="g_public"><mxGeometry x="15" y="180" width="220" height="62" as="geometry"/></mxCell><mxCell id="t_file" value='&lt;b&gt;&lt;font face="Courier New"&gt;source_file&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;object_name, sha256 · Source B&lt;br&gt;ledger (ingested/rejected)&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="g_public"><mxGeometry x="245" y="180" width="220" height="62" as="geometry"/></mxCell><mxCell id="t_heart" value='&lt;b&gt;&lt;font face="Courier New"&gt;consumer_heartbeat&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;last_run_at, processed,&lt;br&gt;oldest_message_age&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="g_public"><mxGeometry x="475" y="180" width="220" height="62" as="geometry"/></mxCell><mxCell id="lane_users" value="Users" style="swimlane;startSize=30;fontStyle=1;fontSize=14;rounded=1;arcSize=1;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#fffbef;html=1;whiteSpace=wrap;container=1;collapsible=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1890" y="60" width="490" height="230" as="geometry"/></mxCell><mxCell id="u_viewer" value="&lt;b&gt;Finance viewers&lt;/b&gt;&lt;br&gt;browser" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1910" y="120" width="200" height="80" as="geometry"/></mxCell><mxCell id="u_google" value="&lt;b&gt;Google sign-in&lt;/b&gt; &lt;span style=&quot;background:#ffe599;border:1px solid #bf9000;border-radius:3px;padding:0 3px;font-weight:bold;&quot;&gt;P2&lt;/span&gt;&lt;br&gt;Supabase Auth, Google only&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;/auth/login → /auth/callback&lt;/font&gt; (PKCE)&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;/auth/logout&lt;/font&gt;&lt;br&gt;not allowlisted → access-denied page" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;spacing=4;dashed=1;dashPattern=8 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2150" y="105" width="210" height="125" as="geometry"/></mxCell><mxCell id="lane_vercel" value="Vercel (read-only)" style="swimlane;startSize=30;fontStyle=1;fontSize=14;rounded=1;arcSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#f8f3fa;html=1;whiteSpace=wrap;container=1;collapsible=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1890" y="330" width="490" height="560" as="geometry"/></mxCell><mxCell id="v_dash" value="&lt;b&gt;Next.js dashboard&lt;/b&gt;&lt;br&gt;revenue by month (stacked by source) + per customer, trend &lt;span style=&quot;background:#ffe599;border:1px solid #bf9000;border-radius:3px;padding:0 3px;font-weight:bold;&quot;&gt;P2&lt;/span&gt;&lt;br&gt;quarantine · drill-down &lt;span style=&quot;background:#ffe599;border:1px solid #bf9000;border-radius:3px;padding:0 3px;font-weight:bold;&quot;&gt;P2&lt;/span&gt;&lt;br&gt;&lt;b&gt;sync health&lt;/b&gt;: last successful sync, newest export, consumer heartbeat,&lt;br&gt;oldest pending msg, DLQ count, reconciliation status → red banner&lt;br&gt;loading: placeholders without figures · per-region &quot;Try again&quot;&lt;br&gt;&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;proxy.ts&lt;/font&gt;&lt;/b&gt;: no session → /login · off allowlist → /denied&lt;br&gt;(full check on page loads; local token check on in-app navigation)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1910" y="375" width="450" height="160" as="geometry"/></mxCell><mxCell id="v_api" value="&lt;b&gt;API routes — GET only&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;/api/revenue/monthly · /api/revenue/customers&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;/api/revenue/documents&lt;/font&gt; &lt;span style=&quot;background:#ffe599;border:1px solid #bf9000;border-radius:3px;padding:0 3px;font-weight:bold;&quot;&gt;P2&lt;/span&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;/api/quarantine · /api/freshness&lt;/font&gt;&lt;br&gt;&lt;b&gt;guarded&lt;/b&gt;: token signature checked locally (getClaims) before any query,&lt;br&gt;then getUser ∥ app_access ∥ query in one parallel batch → 401 · 403 · data&lt;br&gt;Problem Details (RFC 9457): 400 · 401 · 403 · 405 (Allow: GET) · 500&lt;br&gt;Cache-Control: no-store · Server-Timing on allowed responses" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1910" y="580" width="450" height="165" as="geometry"/></mxCell><mxCell id="v_svc" value="&lt;b&gt;services&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;src/services/&lt;/font&gt;&lt;br&gt;handlers never touch the DB; services query&lt;br&gt;with the signed-in user&#x27;s session; independent reads&lt;br&gt;are issued together (one round trip per request)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1910" y="790" width="450" height="90" as="geometry"/></mxCell><mxCell id="lane_repo" value="Repo / CI" style="swimlane;startSize=30;fontStyle=1;fontSize=14;rounded=1;arcSize=1;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fff8f0;html=1;whiteSpace=wrap;container=1;collapsible=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="1370" width="1560" height="150" as="geometry"/></mxCell><mxCell id="r_mig" value='&lt;b&gt;&lt;font face="Courier New"&gt;supabase/migrations/&amp;lt;ts&amp;gt;_customer_mapping.sql&lt;/font&gt;&lt;/b&gt;&lt;br&gt;customer mapping, changed only by a reviewed migration&lt;br&gt;(also: schemas, RLS, grants, queues, cron schedules)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="380" y="1415" width="430" height="80" as="geometry"/></mxCell><mxCell id="lane_legend" value="Legend" style="swimlane;startSize=26;fontStyle=1;fontSize=12;rounded=1;arcSize=1;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;html=1;whiteSpace=wrap;container=1;collapsible=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1890" y="1120" width="490" height="400" as="geometry"/></mxCell><mxCell id="lg_solid" value="" style="line;strokeWidth=2;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1910" y="1160" width="100" height="20" as="geometry"/></mxCell><mxCell id="lg_dash" value="" style="line;strokeWidth=2;strokeColor=#333333;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1910" y="1195" width="100" height="20" as="geometry"/></mxCell><mxCell id="lg_solid_t" value="solid = P1 (must ship)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2025" y="1160" width="300" height="22" as="geometry"/></mxCell><mxCell id="lg_dash_t" value="dashed + &lt;span style=&quot;background:#ffe599;border:1px solid #bf9000;border-radius:3px;padding:0 3px;font-weight:bold;&quot;&gt;P2&lt;/span&gt; = P2 priority (webhook / hints, Google sign-in / allowlist, drill-down, trend labels); all built, the Webhook in ERPNext is not configured yet" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2025" y="1194" width="345" height="44" as="geometry"/></mxCell><mxCell id="lg_src" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;spacing=4;arcSize=15;" vertex="1" parent="1"><mxGeometry x="1910" y="1245" width="40" height="26" as="geometry"/></mxCell><mxCell id="lg_src_t" value="Sources" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1960" y="1248" width="170" height="22" as="geometry"/></mxCell><mxCell id="lg_supa" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;arcSize=15;" vertex="1" parent="1"><mxGeometry x="2140" y="1245" width="40" height="26" as="geometry"/></mxCell><mxCell id="lg_supa_t" value="Supabase" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2190" y="1248" width="170" height="22" as="geometry"/></mxCell><mxCell id="lg_pg" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;arcSize=15;" vertex="1" parent="1"><mxGeometry x="1910" y="1285" width="40" height="26" as="geometry"/></mxCell><mxCell id="lg_pg_t" value="Postgres (inside Supabase)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1960" y="1288" width="170" height="22" as="geometry"/></mxCell><mxCell id="lg_users" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;spacing=4;arcSize=15;" vertex="1" parent="1"><mxGeometry x="2140" y="1285" width="40" height="26" as="geometry"/></mxCell><mxCell id="lg_users_t" value="Users" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2190" y="1288" width="170" height="22" as="geometry"/></mxCell><mxCell id="lg_vercel" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;spacing=4;arcSize=15;" vertex="1" parent="1"><mxGeometry x="1910" y="1325" width="40" height="26" as="geometry"/></mxCell><mxCell id="lg_vercel_t" value="Vercel" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1960" y="1328" width="170" height="22" as="geometry"/></mxCell><mxCell id="lg_repo" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;spacing=4;arcSize=15;" vertex="1" parent="1"><mxGeometry x="2140" y="1325" width="40" height="26" as="geometry"/></mxCell><mxCell id="lg_repo_t" value="Repo / CI" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2190" y="1328" width="170" height="22" as="geometry"/></mxCell><mxCell id="lg_dlq" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1910" y="1375" width="40" height="26" as="geometry"/></mxCell><mxCell id="lg_dlq_t" value="failure path (DLQ)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1960" y="1378" width="200" height="22" as="geometry"/></mxCell><mxCell id="lg_note" value="Edge labels = what travels on the arrow. Schedules are on pg_cron arrows. Everything into the queue is idempotent: upserts keyed on (source, source_doc_id) + atomic version guard. See page &quot;Message lifecycle&quot; for one message's path." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1910" y="1412" width="450" height="100" as="geometry"/></mxCell><mxCell id="e_cron_poll" value="every 5 min (Q3)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;strokeColor=#3d7a3a;fontColor=#1a1a1a;exitX=0.13;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cron" target="fn_poll"><mxGeometry x="-0.4" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_cron_legacy" value="every 5 min" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;strokeColor=#3d7a3a;fontColor=#1a1a1a;exitX=0.5167;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cron" target="fn_legacy"><mxGeometry x="-0.4" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_cron_consumer" value="every 1 min" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;strokeColor=#3d7a3a;fontColor=#1a1a1a;exitX=0.71;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cron" target="fn_consumer"><mxGeometry x="-0.4" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_cron_recon" value="daily + on demand (Q6)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;strokeColor=#3d7a3a;fontColor=#1a1a1a;exitX=0.9033;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cron" target="fn_reconcile"><mxGeometry x="-0.4" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_erp_poll" value="GET Sales Invoice ≤100&lt;br&gt;company, docstatus 1|2&lt;br&gt;keyset (modified, name)&lt;br&gt;overlap −65 min&lt;br&gt;+ GET Deleted Document&lt;br&gt;(own (creation, name) cursor)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;strokeColor=#333333;fontColor=#1a1a1a;exitX=1.0;exitY=0.2143;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="erpnext" target="fn_poll"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_erp_webhook" value='POST webhook &lt;span style="background:#ffe599;border:1px solid #bf9000;border-radius:3px;padding:0 3px;font-weight:bold;"&gt;P2&lt;/span&gt;&lt;br&gt;on_submit / on_cancel /&lt;br&gt;on_update_after_submit / on_trash&lt;br&gt;X-Frappe-Webhook-Signature' style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;strokeColor=#333333;fontColor=#1a1a1a;exitX=1.0;exitY=0.6071;exitDx=0;exitDy=0;entryX=0.24;entryY=1.0;entryDx=0;entryDy=0;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="erpnext" target="fn_webhook"><mxGeometry x="-0.15" relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="400"/></Array></mxGeometry></mxCell><mxCell id="e_consumer_erp" value='GET current doc by name (hint) &lt;span style="background:#ffe599;border:1px solid #bf9000;border-radius:3px;padding:0 3px;font-weight:bold;"&gt;P2&lt;/span&gt;&lt;br&gt;transient failure → hint dropped · 404 → tombstone' style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.04;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.7857;entryDx=0;entryDy=0;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="fn_consumer" target="erpnext"><mxGeometry x="0.12" relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="450"/></Array></mxGeometry></mxCell><mxCell id="e_recon_erp" value="GET name, modified, base_net_total&lt;br&gt;of submitted invoices of the company" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.08;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.9464;entryDx=0;entryDy=0;" edge="1" parent="1" source="fn_reconcile" target="erpnext"><mxGeometry x="-0.9" relative="1" as="geometry"><Array as="points"><mxPoint x="1580" y="495"/></Array><mxPoint x="45" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e_poll_raw" value="raw JSON per&lt;br&gt;document version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.24;exitY=1.0;exitDx=0;exitDy=0;entryX=0.6286;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fn_poll" target="st_raw"><mxGeometry x="0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_poll_queue" value='&lt;font face="Courier New"&gt;enqueue_page&lt;/font&gt; (1 txn):&lt;br&gt;skip version ≤ enqueued_version&lt;br&gt;or in dead_letter · send_batch&lt;br&gt;raise enqueued_version&lt;br&gt;cursor forward-only&lt;br&gt;→ record | tombstone' style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.96;exitY=1.0;exitDx=0;exitDy=0;entryX=0.2222;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fn_poll" target="q_main"><mxGeometry x="0.16" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_webhook_queue" value='hint: doc name only &lt;span style="background:#ffe59