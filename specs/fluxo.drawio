ogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.7667;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="v_dash" target="u_google"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_dash_api" value="fetch GET /api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v_dash" target="v_api"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_api_svc" value="call service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v_api" target="v_svc"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_svc_pg" value="SELECT via RLS on public&lt;br&gt;(user session; allowlisted only)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.1159;entryDx=0;entryDy=0;" edge="1" parent="1" source="v_svc" target="g_public"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="2135" y="1000"/></Array></mxGeometry></mxCell><mxCell id="e_mig_funcs" value="calls internal.apply_customer_mapping(json) (1 txn):&lt;br&gt;replace customer + customer_alias, bump mapping_version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;strokeColor=#d79b00;fontColor=#1a1a1a;exitX=0.7907;exitY=0.0;exitDx=0;exitDy=0;entryX=0.2609;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_mig" target="t_funcs"><mxGeometry x="-0.1" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_mig_queue" value="revalidate&lt;br&gt;(same txn): open UNKNOWN_CUSTOMER&lt;br&gt;quarantine rows + invoices whose&lt;br&gt;alias changed or disappeared" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;strokeColor=#d79b00;fontColor=#1a1a1a;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.6889;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_mig" target="q_main"><mxGeometry x="0.74" relative="1" as="geometry"><Array as="points"><mxPoint x="315" y="1455"/><mxPoint x="315" y="840"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="lifecycle" name="Message lifecycle"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2_title" value="&lt;b&gt;Message lifecycle — one message on invoice_events&lt;/b&gt;&lt;br&gt;Every outcome is applied and the message deleted in the same transaction (internal.apply_record)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="46" as="geometry"/></mxCell><mxCell id="m_queue" value='&lt;b&gt;In queue invoice_events&lt;/b&gt;&lt;br&gt;record · hint &lt;span style="background:#ffe599;border:1px solid #bf9000;border-radius:3px;padding:0 3px;font-weight:bold;"&gt;P2&lt;/span&gt; · tombstone · revalidate' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#b9e0a5;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="340" height="64" as="geometry"/></mxCell><mxCell id="m_read" value="&lt;b&gt;pgmq.read(vt = 180 s, qty = 10)&lt;/b&gt;&lt;br&gt;invoice-consumer&lt;br&gt;message invisible for 180 s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="620" y="160" width="340" height="76" as="geometry"/></mxCell><mxCell id="m_begin" value="&lt;b&gt;internal.begin_attempt(msg_id)&lt;/b&gt;&lt;br&gt;own commit: message_attempt.attempts + 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="620" y="280" width="340" height="64" as="geometry"/></mxCell><mxCell id="m_d_att" value="attempts &amp;gt; 5 (Q4) ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="380" width="220" height="96" as="geometry"/></mxCell><mxCell id="m_dlq" value="&lt;b&gt;Dead letter (1 txn)&lt;/b&gt;&lt;br&gt;send to invoice_events_dlq&lt;br&gt;+ insert dead_letter row&lt;br&gt;+ delete from main queue&lt;br&gt;+ if an older valid version is in invoice:&lt;br&gt;delete it, quarantine PROCESSING_FAILED" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1080" y="388" width="340" height="80" as="geometry"/></mxCell><mxCell id="m_d_kind" value="kind?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="505" width="200" height="80" as="geometry"/></mxCell><mxCell id="m_hint" value='&lt;b&gt;hint&lt;/b&gt; &lt;span style="background:#ffe599;border:1px solid #bf9000;border-radius:3px;padding:0 3px;font-weight:bold;"&gt;P2&lt;/span&gt;&lt;br&gt;fetch current doc via ERPNext adapter' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;spacing=4;dashed=1;dashPattern=8 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="635" width="300" height="70" as="geometry"/></mxCell><mxCell id="m_record" value="&lt;b&gt;record&lt;/b&gt;&lt;br&gt;adapter → candidate" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="640" y="635" width="300" height="70" as="geometry"/></mxCell><mxCell id="m_reval" value="&lt;b&gt;revalidate&lt;/b&gt;&lt;br&gt;load stored candidate (invoice / quarantine)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1000" y="635" width="300" height="70" as="geometry"/></mxCell><mxCell id="m_tomb" value="&lt;b&gt;tombstone&lt;/b&gt;&lt;br&gt;outcome = cancelled" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1360" y="635" width="300" height="70" as="geometry"/></mxCell><mxCell id="m_drop" value="&lt;b&gt;delete hint, no retry&lt;/b&gt;&lt;br&gt;polling is the backstop" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;spacing=4;dashed=1;dashPattern=8 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="750" width="300" height="60" as="geometry"/></mxCell><mxCell id="m_validate" value="&lt;b&gt;validate(candidate, customerIndex, config)&lt;/b&gt;&lt;br&gt;pure; current mapping → outcome valid | invalid |&lt;br&gt;cancelled + mapping_version" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="580" y="765" width="420" height="75" as="geometry"/></mxCell><mxCell id="m_apply" value="&lt;b&gt;internal.apply_record(outcome, msg_id)&lt;/b&gt; — one transaction" style="swimlane;startSize=28;fontStyle=1;fontSize=13;rounded=1;arcSize=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;swimlaneFillColor=#eaf5e9;html=1;whiteSpace=wrap;container=1;collapsible=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="890" width="1320" height="610" as="geometry"/></mxCell><mxCell id="m_d_guard" value="version guard: atomic conditional&lt;br&gt;upsert on record_version&lt;br&gt;— row returned?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="m_apply"><mxGeometry x="390" y="45" width="320" height="120" as="geometry"/></mxCell><mxCell id="m_noop" value="&lt;b&gt;No row = older version&lt;/b&gt;&lt;br&gt;no-op, delete msg" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="m_apply"><mxGeometry x="880" y="70" width="300" height="70" as="geometry"/></mxCell><mxCell id="m_d_map" value="outcome mapping_version&lt;br&gt;= current?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="m_apply"><mxGeometry x="410" y="200" width="280" height="100" as="geometry"/></mxCell><mxCell id="m_d_out" value="outcome?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="m_apply"><mxGeometry x="450" y="335" width="200" height="90" as="geometry"/></mxCell><mxCell id="m_valid" value="&lt;b&gt;valid&lt;/b&gt;&lt;br&gt;upsert invoice + replace lines,&lt;br&gt;resolve open quarantine,&lt;br&gt;then delete msg" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="m_apply"><mxGeometry x="20" y="480" width="340" height="110" as="geometry"/></mxCell><mxCell id="m_invalid" value="&lt;b&gt;invalid&lt;/b&gt;&lt;br&gt;upsert quarantine (open, one reason_code),&lt;br&gt;delete invoice row,&lt;br&gt;then delete msg" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#fbe5d6;" vertex="1" parent="m_apply"><mxGeometry x="380" y="480" width="340" height="110" as="geometry"/></mxCell><mxCell id="m_cancel" value="&lt;b&gt;cancelled&lt;/b&gt; (BR01, tombstone)&lt;br&gt;delete invoice row, resolve quarantine&lt;br&gt;(resolution = cancelled),&lt;br&gt;then delete msg" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3d7a3a;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffffff;" vertex="1" parent="m_apply"><mxGeometry x="740" y="480" width="340" height="110" as="geometry"/></mxCell><mxCell id="m_retry" value='&lt;b&gt;Transient / other error&lt;/b&gt;&lt;br&gt;mapping_version mismatch, DB error,&lt;br&gt;unexpected exception, malformed msg&lt;br&gt;→ &lt;font face="Courier New"&gt;set_vt&lt;/font&gt; 30 s × 2^(attempts−1),&lt;br&gt;cap 15 min; counts toward Q4' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1600" y="1080" width="280" height="140" as="geometry"/></mxCell><mxCell id="m_e1" value="every 1 min (pg_cron)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jetty